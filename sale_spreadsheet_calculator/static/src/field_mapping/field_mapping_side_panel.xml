<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="sale_spreadsheet_calculator.FieldMappingSidePanel">
        <div class="o_sale_field_mapping_panel">
            <Section title="'Cell'">
                <span class="fw-bold" t-esc="cellReference" />
            </Section>
            <Section title="'Order line (position)'">
                <div class="d-flex align-items-center gap-2">
                    <input
                        class="o_input"
                        t-ref="positionInput"
                        type="number"
                        min="1"
                        style="max-width: 5rem;"
                        t-on-change="updatePosition"
                        t-on-focusout="updatePosition"
                    />
                    <span t-if="targetLineLabel" class="text-muted text-truncate">
                        <i class="fa fa-cube me-1" />
                        <t t-esc="targetLineLabel" />
                    </span>
                </div>
            </Section>
            <Section title="'Field to update'">
                <ModelFieldSelector
                    resModel="'sale.order.line'"
                    readonly="false"
                    allowEmpty="false"
                    followRelations="false"
                    filter.bind="filterField"
                    path="fieldMapping.fieldName"
                    update.bind="updateField"
                />
            </Section>
            <div class="o-sidePanelButtons">
                <span t-if="state.saved" class="p-2 text-primary">
                    <i class="fa fa-check me-1" />Saved
                </span>
            </div>
        </div>
    </t>
</templates>
